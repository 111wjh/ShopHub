
DJANGO_SECRET_KEY=replace-with-a-secure-secret-key
DJANGO_DEBUG=False

DB_NAME=shophub
DB_USER=replace-with-your-postgres-user
DB_PASSWORD=replace-with-your-postgres-password
DB_HOST=host.docker.internal
DB_PORT=5432

CELERY_BROKER_URL=redis://host.docker.internal:6379/0
CELERY_RESULT_BACKEND=redis://host.docker.internal:6379/1
